{
  "name": "scenario-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "panda codegen",
    "predev": "node scripts/check-port.mjs 3000",
    "dev": "next dev --turbopack -p 3000",
    "dev:watch": "next dev -p 3333 --turbopack",
    "build": "next build",
    "build:cloudflare": "opennextjs-cloudflare build",
    "buildstart": "next build && next start",
    "preview": "opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare deploy",
    "start": "next start",
    "lint": "biome lint --write",
    "format": "biome format --write",
    "check": "biome check --write",
    "storybook": "storybook dev -p 6006 --no-open --exact-port",
    "build-storybook": "storybook build",
    "test:storybook": "playwright test --config .storybook/playwright.config.ts",
    "vitest": "vitest run",
    "check:ci": "biome check",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:e2e-tools": "vitest run --config scripts/e2e/vitest.config.ts",
    "e2e:inventory": "tsx scripts/e2e/inventory.ts",
    "e2e:ledger:check": "tsx scripts/e2e/ledgerCheck.ts",
    "e2e:ledger:bootstrap": "tsx scripts/e2e/ledgerRefresh.ts bootstrap",
    "e2e:ledger:update": "tsx scripts/e2e/ledgerRefresh.ts update",
    "e2e:environment:check": "tsx scripts/e2e/environmentReproduce.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "pretest:e2e": "kill-port 3100 9323",
    "test:e2e": "cross-env E2E_PORT=3100 playwright test",
    "test:e2e:dev": "cross-env E2E_PORT=3000 E2E_REUSE=1 playwright test",
    "test:e2e:ui": "cross-env E2E_PORT=3000 E2E_REUSE=1 playwright test --ui",
    "test:e2e:headed": "cross-env E2E_PORT=3000 E2E_REUSE=1 playwright test --headed",
    "gen:agents": "node scripts/gen-agents-md.mjs",
    "gen:agents:check": "node scripts/gen-agents-md.mjs --check",
    "codex:skills:export": "powershell -ExecutionPolicy Bypass -File scripts/export-codex-skills.ps1 -Clean",
    "codex:skills:link": "powershell -ExecutionPolicy Bypass -File scripts/link-codex-skills.ps1",
    "codex:skills:unlink": "powershell -ExecutionPolicy Bypass -File scripts/link-codex-skills.ps1 -Unlink"
  },
  "dependencies": {
    "@ark-ui/react": "^5.9.0",
    "@hookform/resolvers": "^5.2.2",
    "@logtape/logtape": "^2.0.2",
    "@paralleldrive/cuid2": "^3.0.6",
    "@phosphor-icons/react": "^2.1.10",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.90.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "jotai": "^2.16.2",
    "next": "16.1.6",
    "nuqs": "^2.8.6",
    "ramda": "^0.30.1",
    "react": "19.2.3",
    "react-day-picker": "^9.13.2",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.71.1",
    "ts-pattern": "^5.7.1",
    "ulid": "^3.0.2",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@biomejs/biome": "2.3.10",
    "@cloudflare/workers-types": "^4.20260127.0",
    "@opennextjs/cloudflare": "^1.14.9",
    "@pandacss/dev": "1.8.1",
    "@playwright/test": "^1.57.0",
    "@storybook/addon-a11y": "10.2.3",
    "@storybook/nextjs-vite": "10.2.3",
    "@storybook/react": "10.2.3",
    "@storybook/test": "^8.6.15",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@tsconfig/strictest": "^2.0.5",
    "@types/node": "^20",
    "@types/ramda": "^0.30.2",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^3.1.4",
    "agentation": "^2.1.1",
    "cross-env": "^10.1.0",
    "jsdom": "^27.4.0",
    "kill-port": "^2.0.1",
    "lefthook": "^1.12.2",
    "playwright": "^1.52.0",
    "storybook": "10.2.3",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vite": "5.2.10",
    "vite-plugin-storybook-nextjs": "3.1.9",
    "vite-tsconfig-paths": "^6.0.4",
    "vitest": "^3.1.4",
    "wrangler": "^4.59.2"
  },
  "pnpm": {
    "neverBuiltDependencies": [
      "esbuild",
      "sharp"
    ],
    "patchedDependencies": {
      "next@16.1.6": "patches/next@16.1.6.patch"
    }
  }
}
